# Zoom API Configuration Example
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to git!

# Primary Zoom Account
ZOOM_ACCOUNT_ID_1=your_primary_account_id
ZOOM_CLIENT_ID_1=your_primary_client_id
ZOOM_CLIENT_SECRET_1=your_primary_client_secret
ZOOM_USER_ID_1=primary_user@company.com

# Secondary Zoom Account (optional)
ZOOM_ACCOUNT_ID_2=your_secondary_account_id
ZOOM_CLIENT_ID_2=your_secondary_client_id
ZOOM_CLIENT_SECRET_2=your_secondary_client_secret
ZOOM_USER_ID_2=secondary_user@company.com

# Default Configuration
DEFAULT_TIMEZONE=America/Los_Angeles
DEFAULT_MEETING_DURATION=60

# Output Configuration
OUTPUT_DIRECTORY=results/
LOG_LEVEL=INFO